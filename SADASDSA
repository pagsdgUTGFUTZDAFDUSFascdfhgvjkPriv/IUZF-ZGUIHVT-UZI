-- Webhook report
--=====================================================================
local function BuildEmbed()
    local rank        = GetRankString()
    local level       = GetStatus(StatusKey.Level)
    local coins       = GetCoins()
    local networth    = GetNetWorth()
    local mystic      = GetStatus(StatusKey.MysticWeaponCount)
    local lifeCases   = GetStatus(StatusKey.Gachaed)

    local kills       = GetStat(StatKey.Kill)
    local headshots   = GetStat(StatKey.HeadshotKill)
    local deaths      = GetStat(StatKey.Death)
    local wins        = GetStat(StatKey.Win)
    local losses      = GetStat(StatKey.Lose)
    local kd          = deaths > 0 and string.format("%.2f", kills / deaths) or tostring(kills)

    local fields = {
        { name = "Uptime",        value = FormatDuration(Uptime()),                 inline = true },
        { name = "Rank (1v1)",    value = rank or "Unranked",                       inline = true },
        { name = "Level",         value = Comma(level),                             inline = true },
        { name = "Coins",         value = Comma(coins),                             inline = true },
        { name = "Net Worth",     value = Comma(networth),                          inline = true },
        { name = "Mystic Items",  value = Comma(mystic),                            inline = true },
        { name = "Kills / Deaths", value = string.format("%s / %s", Comma(kills), Comma(deaths)), inline = true },
        { name = "K/D",           value = kd,                                       inline = true },
        { name = "Headshots",     value = Comma(headshots),                         inline = true },
        { name = "Wins / Losses", value = string.format("%s / %s", Comma(wins), Comma(losses)), inline = true },
        { name = "Cases (session)", value = string.format("%s (%s lifetime)", Comma(Session.CasesOpened), Comma(lifeCases)), inline = true },
        { name = "Sold (session)", value = Comma(Session.ItemsSold),                inline = true },
    }

    return {
        username = "Sniper Arena Farm",
        embeds = {{
            title = "Farm Report",
            color = 8067327,
            fields = fields,
            footer = { text = "farm.lua • " .. os.date("%Y-%m-%d %H:%M:%S") },
        }},
    }
end

local function SendReport(force)
    if webhookUrl == "" or webhookUrl == "PUT_YOUR_DISCORD_WEBHOOK_URL_HERE" then return end

    -- Shared debounce so re-executing (or a lingering old instance) can't spam the webhook — at most
    -- one report per ReportEvery across ALL instances. `force` bypasses it for a manual call.
    if not force and os.time() - (Session.LastReport or 0) < Config.ReportEvery - 5 then return end
    Session.LastReport = os.time()

    local ok, body = pcall(HttpService.JSONEncode, HttpService, BuildEmbed())
    if ok then
        HttpPost(webhookUrl, body)
    end
end

--=====================================================================
-- Main loops
--=====================================================================
-- Everything waits for WaitForGameReady() first, and each heavy action goes through Throttled()
-- so a single pass is spread out over ~7-8s instead of firing five remotes in one frame.
task.spawn(function()
    WaitForGameReady()

    pcall(ApplyInstaSkip)

    -- Keep trying to install the silent-aim hooks until the combat modules are resolvable (they may
    -- not exist in the GC until we're actually in a round with a weapon). Stops once installed.
    task.spawn(function()
        while Alive() and not Ragebot.HooksInstalled do
            SafeCall("installhooks", InstallFireHooks)
            task.wait(2)
        end
    end)

    -- Heavy actions loop (buy/open, sell, equip, claim) — one at a time, spaced out. Requeue is NOT
    -- here: it must be fast, not stuck behind seconds of throttled shop/inventory work.
    task.spawn(function()
        while Alive() do
            Throttled(DoBuyAndOpenCase)
            Throttled(DoAutoSell)
            Throttled(DoAutoEquip)
            Throttled(DoAutoClaim)
            task.wait(Config.LoopInterval)
        end
    end)

    -- Fast lifecycle loop (1s): everything that gets us into the next match ASAP —
    -- rematch off the endgame screen, requeue from the lobby, and ban/vote maps. All idempotent.
    task.spawn(function()
        while Alive() do
            SafeCall("playagain", PlayAgain)      -- endgame screen -> requeue same ranked queue
            SafeCall("tryqueue", TryQueue)        -- lobby -> queue ranked 1v1
            SafeCall("mapphase", AutoMapPhase)    -- ban then vote so the round starts
            task.wait(1)
        end
    end)

    -- Debug state readout so we can see exactly which gate is blocking (turn off via Config.Debug).
    task.spawn(function()
        while Alive() do
            if Config.Debug then
                local room = GetFocusedRoom()
                local state = room and select(2, pcall(function() return room:GetState() end)) or "no-room"
                Log(("DBG target=%s hooks=%s fires=%d filter=%d redirects=%d injects=%d"):format(
                    tostring(Ragebot.CurrentTarget ~= nil), tostring(Ragebot.HooksInstalled),
                    Ragebot.HookFires or 0, Ragebot.FilterPass or 0, Ragebot.Redirects or 0, Ragebot.Injects or 0))
            end
            task.wait(3)
        end
    end)

    -- Webhook reporter loop.
    task.spawn(function()
        SendReport() -- one at startup so you know it's alive
        while Alive() do
            task.wait(Config.ReportEvery)
            SendReport()
        end
    end)

    -- Count deaths from our own humanoid for the session stats.
    task.spawn(function()
        while Alive() do
            local char = LocalCharacter()
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Died:Once(function()
                    Session.Deaths += 1
                end)
            end
            task.wait(3)
        end
    end)
end)

