-- Auto Buy + Open Case
--=====================================================================
-- ShopService.Purchase is a RemoteFunction: InvokeServer("<Product>_x<n>", n). Confirmed via spy:
--   Remote.ShopService.Purchase:InvokeServer("StrikeCase_Premium_x1", 1)
local function BuyCase()
    if not Config.AutoBuyCase then return end

    -- Optional reserve guard (only if we can read coins).
    if Config.CaseKeepCoins > 0 then
        local coins = GetCoins()
        if coins and coins <= Config.CaseKeepCoins then return end
    end

    local shop = ReplicatedStorage:FindFirstChild("Remote")
    shop = shop and shop:FindFirstChild("ShopService")
    local purchase = shop and shop:FindFirstChild("Purchase")
    if not purchase then return end

    -- Server validates affordability/eligibility; a rejection is harmless.
    pcall(function()
        return purchase:InvokeServer(Config.BuyProduct, 1)
    end)
end

local function DoBuyAndOpenCase()
    BuyCase()

    -- Open however many of the case we own (direct gacha remote = instant, no animation).
    if Config.AutoOpenCase then
        local gacha = GachaService()
        if gacha and gacha.GetGachaCount then
            local ownOk, owned = pcall(gacha.GetGachaCount, Config.CaseKey)
            if ownOk and type(owned) == "number" and owned > 0 then
                local amount = math.min(owned, 10)
                local openOk = pcall(gacha.Gacha, Config.CaseKey, amount)
                if openOk then
                    Session.CasesOpened += amount
                    Log("opened", amount, Config.CaseKey)
                end
            end
        end
    end
end

-- Insta-skip: enable the game's SkipGachaAnim setting so any opening is instant. (Opening via the
-- gacha remote is already instant, but this covers the UI path and any client-side open lock.)
local function ApplyInstaSkip()
    if not Config.InstaSkip then return end
    local settingSvc = ResolveModule(SafeChild(ReplicatedStorage, "Remote", "SettingService"), { "Settings" })
    local setting = settingSvc and settingSvc.Settings and settingSvc.Settings.SkipGachaAnim
    if setting then
        pcall(function() setting.Value = true end)
    end
end

--=====================================================================
-- Auto Equip most valuable glove / knife / gun (SSG)
--=====================================================================
-- Picks the highest-Rap owned item of each slot and equips it. Non-destructive.
local function DoAutoEquip()
    if not Config.AutoEquip then return end
    local weapon = WeaponService()
    local equip = EquipmentService()
    local wdh = WeaponDataHelper()
    if not weapon or not equip or not wdh then return end

    local content = weapon.GetContent and weapon.GetContent()
    if type(content) ~= "table" then return end

    -- Bucket by weapon family/base name; find the highest-priced variant we own per family.
    local best = {}   -- baseName -> { uid, price }
    for uid, data in pairs(content) do
        local cfgOk, cfg = pcall(wdh.GetConfig, data)
        local nameOk, name = pcall(wdh.Name, data)
        if cfgOk and cfg and nameOk and name then
            local base = tostring(name):match("^([^.]+)") or name
            local priceOk, price = pcall(wdh.Price, data)
            price = (priceOk and type(price) == "number") and price or 0
            if not best[base] or price > best[base].price then
                best[base] = { uid = uid, price = price, data = data }
            end
        end
    end

    -- Equip the best of each. SetEquip signature is (uid / weaponKey, ...) — try the common shape.
    for _, entry in pairs(best) do
        pcall(equip.SetEquip, entry.uid)
    end
end

--=====================================================================
-- Auto Claim free rewards (mailbox + battlepass)
--=====================================================================
local function DoAutoClaim()
    if not Config.AutoClaim then return end

    local mail = Mailbox()
    if mail and mail.GetAll then
        local ok, list = pcall(mail.GetAll)
        if ok and type(list) == "table" then
            for _, item in pairs(list) do
                local id = type(item) == "table" and (item.Id or item.id or item.Key) or item
                if id then pcall(mail.Claim, id) end
            end
        end
    end

    local bp = Battlepass()
    if bp then
        pcall(function() bp.ClaimPremiumReward() end)
        pcall(function() bp.ClaimRebirthReward() end)
    end
end

--=====================================================================
-- Auto Requeue ranked
--=====================================================================
-- We're "in a match" once we've joined a game client (covers pre-round vote + the live round);
-- queueing again during that window would be wrong.
local function InMatch()
    return IsJoined()
end

-- Resolve the ranked 1v1 queue key from the game's own matchmaking config (Ranked + TeamSize 1),
-- so we don't depend on a decompiler-mangled string. Cached after first lookup.
local ResolvedQueue = nil
local function GetRankedQueue()
    if Config.RankedQueue then return Config.RankedQueue end
    if ResolvedQueue then return ResolvedQueue end

    local mmConfig = ResolveModule(SafeChild(ReplicatedStorage, "Config", "Config", "Matchmaking"), { "Queues" })
    if mmConfig and type(mmConfig.Queues) == "table" then
        for name, q in pairs(mmConfig.Queues) do
            if q.Ranked and (q.TeamSize == 1 or q.Players == 2) then
                ResolvedQueue = q.Name or name
                return ResolvedQueue
            end
        end
    end
    return nil
end

local function TryQueue()
    if not Config.AutoRequeue then return end
    local mm = Matchmaking()
    if not mm then return end
    if mm.Matching then return end          -- already in queue
    if InMatch() then return end            -- still in a match / scoreboard

    local queue = GetRankedQueue()
    if not queue then return end

    -- Match() can yield waiting on the _Ready flag; spawn it so it never stalls the lifecycle loop.
    task.spawn(function()
        local ok, res = pcall(mm.Match, queue)   -- Match(key): field fn, no self
        Log("queue ->", queue, ok and ("res=" .. tostring(res)) or "call failed")
    end)
end

--=====================================================================
-- K/D normalizer  (throw ~LossRate of games)
--=====================================================================
local function RollGame()
    if not Config.KDNormalizer then
        Ragebot.WhiffThisGame = false
        return
    end
    Ragebot.WhiffThisGame = math.random() < Config.LossRate
    if Ragebot.WhiffThisGame then
        Log("K/D normalizer: throwing this game")
    end
end

-- Roll per match: decide when a round actually goes live (IsGaming rising edge), not merely on join.
task.spawn(function()
    local was = false
    while Alive() do
        local now = IsGaming()
        if now and not was then
            RollGame()
        end
        was = now
        task.wait(1)
    end
end)

