-- pcall that surfaces the FIRST error per label (instead of silently swallowing it), so a broken
-- gate is visible in the console instead of just "nothing happens".
local ErrLogged = {}
local function SafeCall(label, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok and not ErrLogged[label] then
        ErrLogged[label] = true
        Log("ERROR in", label, "->", tostring(err))
    end
    return ok
end

-- Universal executor HTTP request.
local function HttpPost(url, body)
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return false end
    return pcall(req, {
        Url = url,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body,
    })
end

-- Safe require of a game module.
local function Require(path)
    local ok, mod = pcall(require, path)
    if ok then return mod end
    return nil
end

--=====================================================================
-- Anti-crash pacing
--=====================================================================
-- Executors fire autoexec the instant they inject — long before the game's scripts/remotes exist.
-- Touching remotes or spamming actions that early is the #1 cause of the client crashing, so we
-- gate everything behind "the game is actually ready", then throttle heavy actions so no single
-- tick does too much work.

local Ready = false

local function WaitForGameReady()
    -- 1) engine content loaded
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end
    Log("engine loaded")

    -- 2) the remote tree the farm depends on has replicated in (bounded — never block forever).
    -- NOTE: we deliberately do NOT wait on the character here. On the match-over scoreboard the
    -- character is despawned, so CharacterAdded would never fire until the next round — that would
    -- hang the whole farm and stop it requeueing. Combat already gates on IsGaming() at runtime,
    -- so a nil character between rounds is fine.
    local deadline = os.clock() + 30
    repeat
        local remote = ReplicatedStorage:FindFirstChild("Remote")
        if remote and remote:FindFirstChild("MatchmakingService") then
            break
        end
        task.wait(0.25)
    until os.clock() > deadline
    Log("remotes present")

    -- 3) wait until the in-game HUD is built — the ban-screen element only exists once every remote/
    -- module has fully loaded, so this is a rock-solid "everything's ready" signal (per your tip).
    -- Bounded so a mid-match exec (HUD already past ban phase but present) doesn't hang.
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 15)
    local hudDeadline = os.clock() + 45
    repeat
        local node = pg and pg:FindFirstChild("Hud")
        node = node and node:FindFirstChild("Game")
        node = node and node:FindFirstChild("BanMap")
        if node then break end
        task.wait(0.25)
    until os.clock() > hudDeadline
    Log("hud ready (ban screen built)")

    -- 4) tiny settle, then go live
    task.wait(Config.StartupDelay)
    Ready = true
    Log("game ready — farm going live")
end

-- Run a heavy action but never faster than Config.ActionGap since the last heavy action, so a full
-- farm pass is spread out across time instead of slamming the client in one frame.
local LastAction = 0
local function Throttled(fn)
    local wait = Config.ActionGap - (os.clock() - LastAction)
    if wait > 0 then task.wait(wait) end
    LastAction = os.clock()
    return pcall(fn)
end

