end
Session.Running = true
Session.Connections = {}
Session.Version = (Session.Version or 0) + 1
local MyVersion = Session.Version   -- lets an older copy of the script bow out if re-executed

local function Alive()
    return Session.Running and Session.Version == MyVersion
end

-- Track every connection on the session so the next exec can tear them down.
local function Connect(signal, fn)
    local c = signal:Connect(fn)
    Session.Connections[#Session.Connections + 1] = c
    return c
end

local function Uptime()
    return os.time() - Session.StartTime
end

local function FormatDuration(sec)
    sec = math.floor(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

--=====================================================================
-- Game services (lazy — may not exist until loaded)
--=====================================================================
-- Find an already-loaded module table in the GC by keys unique to it. Your executor (SynZ) doesn't
-- share the game's require cache — re-requiring re-runs the module, which yields/errors on the heavy
-- ones (GameService, etc.). So when require fails we grab the LIVE singleton the game already built.
-- getgc(true) is a full heap scan — brutal to call every frame. Cache the snapshot for 2s so all
-- services resolve from ONE scan, and unresolved ones only re-scan every 2s instead of per-frame.
local _gcSnapshot, _gcSnapTime = nil, -1e9
local function FindLoadedModule(sigKeys)
    if type(getgc) ~= "function" then return nil end
    if not _gcSnapshot or os.clock() - _gcSnapTime > 2 then
        _gcSnapshot = getgc(true)
        _gcSnapTime = os.clock()
    end
    for _, obj in ipairs(_gcSnapshot) do
        if type(obj) == "table" then
            local match = true
            for i = 1, #sigKeys do
                if rawget(obj, sigKeys[i]) == nil then match = false break end
            end
            if match then return obj end
        end
    end
    return nil
end

-- Require a module; fall back to the live GC copy (matched by signature) if require fails.
local function ResolveModule(inst, sigKeys)
    local ok, mod = pcall(require, inst)
    if ok and type(mod) == "table" then return mod end
    return sigKeys and FindLoadedModule(sigKeys) or nil
end

-- Walk a child path with FindFirstChild so a missing/removed node returns nil instead of THROWING
-- ("Remote is not a valid member of ReplicatedStorage"). The Remote folder isn't reliably dot-index-
-- able during a match, and that throw was killing the ragebot, playagain AND the fire-hook install.
local function SafeChild(root, ...)
    local node = root
    for _, seg in ipairs({ ... }) do
        if not node then return nil end
        node = node:FindFirstChild(seg)
    end
    return node
end

-- Each service caches its resolved module. `sig` = keys unique to that module for the GC fallback.
local Svc = {}
local function GetSvc(name, path, sig)
    if not Svc[name] then   -- keep retrying until resolved (false = not yet)
        Svc[name] = ResolveModule(path, sig) or false
    end
    return Svc[name] or nil
end

