-- GameService: cached singleton; require first, GC fallback second. IsGaming/room/ban/vote/rematch
-- all hang off this, so it MUST resolve.
local _gameServiceMod
local _gsLogged = false
local function GameService()
    if _gameServiceMod then return _gameServiceMod end
    local remote = ReplicatedStorage:FindFirstChild("Remote")
    local svc = remote and remote:FindFirstChild("GameService")

    local viaRequire = false
    local reqOk, reqMod = pcall(require, svc)
    if reqOk and type(reqMod) == "table" then _gameServiceMod, viaRequire = reqMod, true end

    if not _gameServiceMod then
        _gameServiceMod = FindLoadedModule({ "IsGaming", "IsJoined", "RoomManager", "VoteMap", "BanMap" })
    end

    if _gameServiceMod and not _gsLogged then
        _gsLogged = true
        Log("GameService resolved via " .. (viaRequire and "require" or "GC"))
    end
    return _gameServiceMod
end

--=====================================================================
-- Game state  (loading vs lobby vs map-voting vs live round)
--=====================================================================
-- The game runs you through: loading screen -> lobby -> matchmaking -> map vote -> LIVE round.
-- GameService tells us exactly which phase we're in, so the ragebot only fires during a live round
-- and never wastes shots (or crashes) on a loading/lobby/voting screen.
local function IsGaming()   -- true ONLY while an actual round is live
    local gs = GameService()
    if not gs or not gs.IsGaming then return false end
    local ok, v = pcall(gs.IsGaming)
    return ok and v == true
end

local function IsJoined()   -- true once we've joined a match client (round or its pre-round phases)
    local gs = GameService()
    if not gs or not gs.IsJoined then return false end
    local ok, v = pcall(gs.IsJoined)
    return ok and v == true
end

local function GetFocusedRoom()
    local gs = GameService()
    local rm = gs and gs.RoomManager
    if not rm or not rm.GetFocusedRoom then return nil end
    local ok, room = pcall(rm.GetFocusedRoom)
    return ok and room or nil
end

-- True while sitting on the match-over / results screen (round has ended or is ending). Read from
-- the room's authoritative GameState, so it's correct even if we EXECUTE on the endgame screen and
-- never saw the round go live.
local function RoomEnded()
    local room = GetFocusedRoom()
    if not room then return false end
    local ok, ended = pcall(function()
        return room:IsEnded() or room:IsEnding()
    end)
    return ok and ended or false
end

-- Fire the endgame "Play Again" button. It re-queues the SAME queue straight from the results screen
-- (no trip back to the lobby): MatchmakingService.Match(queue) -> ModeHandler:Rematch(false) -> Pause.
-- Replicates Hud/Game/EndList/Bottom/ContinueAgain exactly.
local LastPlayAgain = 0
local function PlayAgain()
    if not RoomEnded() then return end                 -- only on the endgame screen
    if os.clock() - LastPlayAgain < 2 then return end  -- don't double-fire during the transition

    local room = GetFocusedRoom()
    if not room then if Config.Debug then Log("playagain: no focused room") end return end

    -- The requeue key lives on the mode handler. If it's present we can rematch — no need to gate on
    -- IsModeSet (which was silently blocking this).
    local handler = room.ModeHandler
    local queue = handler and handler.MatchmakingQueue
    if not queue or #queue == 0 then
        if Config.Debug then Log("playagain: no MatchmakingQueue (handler=" .. tostring(handler ~= nil) .. ")") end
        return
    end

    local mm = Matchmaking()
    if not mm then return end
    if mm.Matching then if Config.Debug then Log("playagain: already matching") end return end

    LastPlayAgain = os.clock()
    Log("play again ->", queue)

    -- Match() can yield on the _Ready flag; spawn so the endgame screen requeues without blocking.
    task.spawn(function()
        pcall(mm.Match, queue)                                      -- requeue the same ranked queue
        pcall(function() if handler.Rematch then handler:Rematch(false) end end)
        local gs = GameService()
        if gs and gs.Pause then pcall(gs.Pause) end
    end)
end

-- Map selection is a BAN phase (RoomState.BanMap) followed by a VOTE phase (RoomState.Vote). Both
-- stall the round if we're AFK and don't act, so handle whichever the room is currently in.
--   ban:  GameService.BanMap(map, clickPos)   from room.BanMaps.Maps
--   vote: GameService.VoteMap(map, clickPos)  from room.VotingMaps.Maps
local CENTER = UDim2.new(0.5, 0, 0.5, 0)
local function AutoMapPhase()
    local gs = GameService()
    local room = GetFocusedRoom()
    if not gs or not room then return end

    local ok, state = pcall(function() return room:GetState() end)
    if not ok then return end

    if state == "BanMap" and gs.BanMap then
        if LocalPlayer:GetAttribute("BanMap") then return end       -- already banned this round
        local bm = room.BanMaps
        if type(bm) ~= "table" or type(bm.Maps) ~= "table" or #bm.Maps == 0 then return end
        if Workspace:GetServerTimeNow() > (bm.Timeout or 0) then return end

        -- Prefer banning the configured map (Grid) if it's in the pool; otherwise random.
        local pick
        if Config.BanMapName then
            for i = 1, #bm.Maps do
                if bm.Maps[i] == Config.BanMapName then pick = bm.Maps[i] break end
            end
        end
        pick = pick or bm.Maps[math.random(1, #bm.Maps)]

        pcall(gs.BanMap, pick, CENTER)
        Log("banned map", pick)

    elseif state == "Vote" and gs.VoteMap then
        if LocalPlayer:GetAttribute("VoteMap") then return end       -- already voted this round
        local vm = room.VotingMaps
        if type(vm) ~= "table" or type(vm.Maps) ~= "table" or #vm.Maps == 0 then return end
        if Workspace:GetServerTimeNow() > (vm.Timeout or 0) then return end
        local pick = vm.Maps[math.random(1, #vm.Maps)]
        pcall(gs.VoteMap, pick, CENTER)
        Log("voted map", pick)
    end
end

--=====================================================================
-- Ragebot  (compact, self-contained: pick nearest visible enemy, aim head, fire)
--=====================================================================
local Ragebot = {}
Ragebot.CurrentTarget = nil
Ragebot.WhiffThisGame = false        -- set by the K/D normalizer to throw the round

local function LocalCharacter()
    return LocalPlayer.Character
end

local function LocalRoot()
    local c = LocalCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function IsFriendly(character)
    -- Team-based: same Team = friendly. Falls back to false (treat as enemy) if teams unknown.
    local plr = Players:GetPlayerFromCharacter(character)
    if plr and plr.Team and LocalPlayer.Team then
        return plr.Team == LocalPlayer.Team
    end
    return false
end

local function EnemyAlive(character)
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return hum ~= nil and root ~= nil and hum.Health > 0
end

-- Body points we try to hit, in priority order (R15 + R6 covered).
local HIT_POINTS = { "Head", "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso" }

-- Is this player friendly to us? Uses the game's own EntityService.IsFriendly (handles teams/1v1),
-- falls back to Team, else treats as enemy.
local function PlayerFriendly(plr)
    local ent = EntityService()
    if ent and ent.IsFriendly then
        local ok, res = pcall(ent.IsFriendly, plr)
        if ok and res ~= nil then return res end
    end
    if plr.Team and LocalPlayer.Team then return plr.Team == LocalPlayer.Team end
    return false
end

-- Build a Skeet-style Data list of live enemies with their body parts (rebuilt each shot/frame).
local function GatherEnemies()
    local myRoot = LocalRoot()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if char and hum and root and hum.Health > 0 and not PlayerFriendly(plr) then
                local parts = {}
                for i = 1, #HIT_POINTS do
                    local p = char:FindFirstChild(HIT_POINTS[i])
                    if p and p:IsA("BasePart") then parts[HIT_POINTS[i]] = p end
                end
                list[#list + 1] = {
                    Character = char, Player = plr, Humanoid = hum,
                    RootPart = root, RootPosition = root.Position, BodyParts = parts,
                    Distance = myRoot and (root.Position - myRoot.Position).Magnitude or 0,
                }
            end
        end
    end
    return list
end

-- Nearest enemy CHARACTER, for pathfinding/CurrentTarget.
local function GetNearestEnemy()
    local best, bestDist = nil, math.huge
    for _, d in ipairs(GatherEnemies()) do
        if d.Distance < bestDist then bestDist = d.Distance; best = d.Character end
    end
    return best
end

--=====================================================================
-- Wall-check raycasting  (exclude every character + local, use the Attack collision group — 1:1 Skeet)
--=====================================================================
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local LastRayRefresh = 0
local function RefreshRayFilter(enemies)
    if os.clock() - LastRayRefresh < 0.1 then return end
    LastRayRefresh = os.clock()

    local filter, n = {}, 0
    local lc = LocalCharacter()
    if lc then n = n + 1; filter[n] = lc end
    local vm = Camera:FindFirstChild("ViewModel")
    if vm then n = n + 1; filter[n] = vm end
    for i = 1, #enemies do
        if enemies[i].Character then n = n + 1; filter[n] = enemies[i].Character end
    end
    RayParams.FilterDescendantsInstances = filter

    local ent = EntityService()
    local le = ent and ent.GetLocalEntity and select(2, pcall(ent.GetLocalEntity))
    if le and le.GetCollision then
        local ok, col = pcall(le.GetCollision, le, "Attack")
        if ok and col then RayParams.CollisionGroup = col end
    end
end

local function RayBlocked(origin, goal)
    return Workspace:Raycast(origin, goal - origin, RayParams) ~= nil
end

-- Sample points across a part to find one with clear line of sight (Skeet's SampleVisiblePoint).
local function SampleVisiblePoint(origin, part)
    local size, cf = part.Size, part.CFrame
    local hx, hy = size.X * 0.35, size.Y * 0.35
    local offsets = {
        Vector3.new(0, 0, 0), Vector3.new(hx, 0, 0), Vector3.new(-hx, 0, 0),
        Vector3.new(0, hy, 0), Vector3.new(0, -hy, 0), Vector3.new(hx, hy, 0), Vector3.new(-hx, -hy, 0),
    }
    for i = 1, #offsets do
        local wp = (cf * CFrame.new(offsets[i])).Position
        if not RayBlocked(origin, wp) then return wp end
    end
    return nil
end

--=====================================================================
-- Resolver  (true server positions via the game's chrono custom replication)
--=====================================================================
-- Sniper Arena replicates real positions/velocities through ReplicatedStorage.Shared.chrono, and the
-- rendered character LAGS behind that. Aiming at the rendered head misses on the server. We pull the
-- true root CFrame + velocity from chrono, reproject our aim point onto the true position, and lead
-- by velocity*ping — exactly what the Skeet ragebot does.
local Resolver = {}

-- Lazily require chrono the first time we actually need it (during a live round), inside a pcall'd
-- closure so a not-yet-replicated path can't throw at load time. Cached; false = tried and absent.
function Resolver.GetChrono()
    if Resolver.Chrono == nil then
        local ok, chrono = pcall(function()
            return require(ReplicatedStorage.Shared.chrono.Client.Replicate)
        end)
        if not (ok and type(chrono) == "table") then
            -- require failed (executor cache) — grab the live chrono singleton from the GC instead.
            chrono = FindLoadedModule({ "idMap", "GetVelocity", "GetAllNetworkIds" })
        end
        Resolver.Chrono = chrono or false
        if Resolver.Chrono and Config.Debug then Log("chrono resolved") end
    end
    return Resolver.Chrono or nil
end

local function GetPing()
    local ok, ms = pcall(function() return Stats.PerformanceStats.Ping:GetValue() end)
    return (ok and type(ms) == "number") and (ms / 1000) or 0   -- seconds, round-trip
end

-- Latest true root CFrame for a player from chrono's snapshot buffer, or nil.
function Resolver.TrueRootCFrame(player)
    local chrono = Resolver.GetChrono()
    if not chrono or not player then return nil end

    local ok, ids = pcall(chrono.GetAllNetworkIds)
    if not ok or type(ids) ~= "table" then return nil end

    for i = 1, #ids do
        local entry = chrono.idMap[ids[i]]
        if entry and entry.player == player then
            local snap = entry.snapshot and entry.snapshot:GetLatest()
            if snap and typeof(snap.value) == "CFrame" then return snap.value end
            return nil
        end
    end
    return nil
end

function Resolver.TrueVelocity(player, fallbackPart)
    local chrono = Resolver.GetChrono()
    if chrono and player then
        local ok, v = pcall(chrono.GetVelocity, player)
        if ok and typeof(v) == "Vector3" and v.Magnitude > 0 then return v end
    end
    return (fallbackPart and fallbackPart.AssemblyLinearVelocity) or Vector3.new()
end

-- Reproject a rendered aim point onto the true position, then add velocity lead. renderedRoot is the
-- rendered HumanoidRootPart; renderedPoint is where we'd aim on the rendered model (e.g. Head).
function Resolver.ResolveAim(player, renderedRoot, renderedPoint)
    local point = renderedPoint

    local trueCF = Resolver.TrueRootCFrame(player)
    if trueCF and renderedRoot then
        local delta = trueCF.Position - renderedRoot.Position
        if delta.Magnitude <= 10 then          -- sane correction only; ignore garbage snapshots
            point = point + delta
        end
    end

    local lead = Resolver.TrueVelocity(player, renderedRoot) * (GetPing() * Config.Prediction)
    if lead.Magnitude > 20 then lead = lead.Unit * 20 end   -- cap over-lead

    return point + lead
end

--=====================================================================
-- Silent-aim fire hooks
--=====================================================================
-- CRITICAL: the server registers damage from the Shoot action's Target + TargetPos (an object-space
-- point on the target's root), NOT from where the camera points — see CommonShootableComponent's
-- Request serializer (Target / TargetPos / TargetHeadshot / Direction / Spread). So we do NOT aim the
-- camera. Autofire shoots in whatever direction we already face, and two hooks rewrite the outgoing
-- action to point at the resolved target. This is exactly how the Skeet ragebot lands shots without
-- looking, and it's the piece that was missing (a camera lookAt does nothing server-side).
Ragebot.PendingRedirect = nil
Ragebot.HooksInstalled = false

-- Reproject a rendered world point onto the target's true (server) position — no lead (Skeet's
-- ReprojectPoint). Returns the input unchanged if there's no valid true position.
function Resolver.ReprojectPoint(player, renderedRoot, worldPoint)
    local trueCF = Resolver.TrueRootCFrame(player)
    if not renderedRoot or not trueCF then return worldPoint end
    local delta = trueCF.Position - renderedRoot.Position
    if delta.Magnitude > 10 then return worldPoint end   -- garbage snapshot, don't correct
    return worldPoint + delta
end

-- SelectTarget: closest live enemy we actually have line of sight to. Skips a target whose root is
-- wall-blocked AND whose head has no visible point — exactly Skeet's wall check.
local function SelectTarget(enemies, origin)
    local best, bestScore = nil, math.huge
    for i = 1, #enemies do
        local data = enemies[i]
        if data.Humanoid.Health > 0 then
            local blocked = false
            if Config.WallCheck and origin then
                local rootPos = data.RootPosition
                local trueCF = Resolver.TrueRootCFrame(data.Player)
                if trueCF and (trueCF.Position - rootPos).Magnitude <= 10 then rootPos = trueCF.Position end

                local rootBlocked = RayBlocked(origin, rootPos)
                local head = rootBlocked and data.BodyParts["Head"]
                local visibleHead = head and SampleVisiblePoint(origin, head)
                if rootBlocked and not visibleHead then blocked = true end
            end

            if not blocked and data.Distance < bestScore then
                bestScore = data.Distance
                best = data
            end
        end
    end
    return best
end

-- PickPoint: choose the best VISIBLE body point (Head first), reproject to true pos, add velocity
-- lead. Returns (part, worldPosition) or nil if every candidate is wall-blocked. 1:1 with Skeet.
local function PickPoint(data, origin)
    local candidates = {}
    for i = 1, #HIT_POINTS do
        local p = data.BodyParts[HIT_POINTS[i]]
        if p then candidates[#candidates + 1] = p end
    end

    if #candidates == 0 then return nil end

    local part, visiblePoint
    for i = 1, #candidates do
        local cand = candidates[i]
        if not Config.WallCheck or not origin then part = cand break end
        if not RayBlocked(origin, cand.Position) then part = cand break end
        local sampled = SampleVisiblePoint(origin, cand)
        if sampled then part = cand; visiblePoint = sampled break end
    end

    -- No visible point (fully wall-blocked) → no shot, exactly like Skeet. Pathfinding walks us to LoS.
    if not part then return nil end

    local position = visiblePoint or part.Position
    position = Resolver.ReprojectPoint(data.Player, data.RootPart, position)

    local lead = Resolver.TrueVelocity(data.Player, data.RootPart) * (GetPing() * Config.Prediction)
    if lead.Magnitude > 20 then lead = lead.Unit * 20 end
    position = position + lead

    return part, position
end

local function InstallFireHooks()
    if Ragebot.HooksInstalled then return end
    if not (hookfunction and newcclosure) then
        Log("executor lacks hookfunction/newcclosure — silent aim unavailable")
        return
    end

    local shootMod  = ShootComponent()
    local entitySvc = EntityService()
    local combat    = CombatService()
    if not shootMod or not entitySvc or not combat then
        if Config.Debug then
            Log(("hooks waiting: shoot=%s entity=%s combat=%s"):format(
                tostring(shootMod ~= nil), tostring(entitySvc ~= nil), tostring(combat ~= nil)))
        end
        return   -- retried by the install loop until all three resolve
    end

    local shootAction = shootMod.Action and shootMod.Action.Shoot

    -- Resolve the PitchYaw network query — invoking it replicates our aim (pitch+yaw) to the server,
    -- which the server validates the shot against. Without setting it to the target on each shot the
    -- server sees us aimed elsewhere and the hit misses. (Skeet: EntityService.Common.Network...)
    for _, getter in ipairs({
        function() return entitySvc.Common.Network.Packets.queries.PitchYaw end,
        function() return entitySvc.Common.Network.queries.PitchYaw end,
    }) do
        local ok, q = pcall(getter)
        if ok and type(q) == "table" and q.invoke then Ragebot.PitchYawQuery = q break end
    end
    if Config.Debug then Log("PitchYaw query: " .. tostring(Ragebot.PitchYawQuery ~= nil)) end

    -- 1) Redirect OUR shots at the resolved target, and stash the redirect for the action hook.
    local oldShoot
    oldShoot = hookfunction(shootMod.Shoot, newcclosure(function(self, start, dir, params)
        if typeof(start) ~= "Vector3" or typeof(dir) ~= "Vector3" or not self or not self.Holder then
            return oldShoot(self, start, dir, params)
        end
        Ragebot.HookFires = (Ragebot.HookFires or 0) + 1

        -- Only skip if we can POSITIVELY confirm this is another entity's shot; if we can't tell,
        -- assume it's ours (the strict version was silently dropping all redirects).
        local okHolder, holderEntity = pcall(self.GetHolderEntity, self)
        local okLocal, localEntity = pcall(entitySvc.GetLocalEntity)
        if okHolder and okLocal and localEntity and holderEntity and holderEntity ~= localEntity then
            return oldShoot(self, start, dir, params)
        end
        Ragebot.FilterPass = (Ragebot.FilterPass or 0) + 1

        if not (Config.Ragebot and Ready and IsGaming() and not Ragebot.WhiffThisGame) then
            return oldShoot(self, start, dir, params)
        end

        local enemies = GatherEnemies()
        if Config.WallCheck then RefreshRayFilter(enemies) end
        local target = SelectTarget(enemies, start)
        if target then
            local part, position = PickPoint(target, start)
            if part and position then
                Ragebot.PendingRedirect = {
                    Start = start,
                    Direction = (position - start).Unit,
                    Time = Workspace:GetServerTimeNow(),
                    Player = target.Player,
                    ObjectSpacePos = target.RootPart.CFrame:PointToObjectSpace(position),
                    Headshot = part.Name == "Head",
                }
                Ragebot.Redirects = (Ragebot.Redirects or 0) + 1

                -- On-shot: replicate our pitch/yaw pointing straight at the hit position, so the
                -- server's aim check agrees the shot was aimed at the target. THIS is the piece that
                -- was making shots miss server-side.
                if Ragebot.PitchYawQuery then
                    local pitch, yaw = CFrame.lookAt(start, position):ToOrientation()
                    pcall(Ragebot.PitchYawQuery.invoke, { Pitch = pitch, Yaw = yaw })
                end

                return oldShoot(self, start, Ragebot.PendingRedirect.Direction, params)
            end
        end

        return oldShoot(self, start, dir, params)
    end))

    -- 2) Inject Target / TargetPos / Direction / Spread into the networked Shoot action.
    task.spawn(function()
        local weapon
        for _ = 1, 60 do
            local ok, w = pcall(combat.GetCurrentWeapon)
            if ok and w then weapon = w break end
            task.wait(0.1)
        end
        if not weapon or not weapon.InvokeAction then return end

        local oldInvoke
        oldInvoke = hookfunction(weapon.InvokeAction, newcclosure(function(self, actionName, params, ...)
            local pending = Ragebot.PendingRedirect
            local matches = actionName == shootAction and pending
                and (Workspace:GetServerTimeNow() - pending.Time < 0.5)
                and type(params) == "table" and typeof(params.Start) == "Vector3"
                and (params.Start - pending.Start).Magnitude < 5

            if matches then
                params.Direction = pending.Direction
                params.Spread = 0
                if pending.Player and pending.ObjectSpacePos then
                    params.Target = pending.Player
                    params.TargetPos = pending.ObjectSpacePos
                    params.TargetHeadshot = pending.Headshot or false
                end
                Ragebot.Injects = (Ragebot.Injects or 0) + 1
                Ragebot.PendingRedirect = nil
            end

            return oldInvoke(self, actionName, params, ...)
        end))
        Log("action hook installed")
    end)

    Ragebot.HooksInstalled = true
    Log("fire hooks installed (silent aim active)")
end

-- Ragebot: pick the closest enemy, resolve the aim point, lock the camera onto it, and fire on
-- cooldown. The Shoot hook still redirects + injects Target/TargetPos for precise server-side hit reg.
function Ragebot.Step()
    if not Ready or not Config.Ragebot or not Alive() then return end
    if not IsGaming() then Ragebot.CurrentTarget = nil return end   -- only fight during a live round
    if Ragebot.WhiffThisGame then return end        -- intentionally do nothing this game

    local enemies = GatherEnemies()
    if Config.WallCheck then RefreshRayFilter(enemies) end

    -- Pathfinding chases the nearest enemy regardless of walls (so we walk toward line of sight);
    -- firing only targets one we can actually see.
    Ragebot.CurrentTarget = GetNearestEnemy()

    local target = SelectTarget(enemies, Camera.CFrame.Position)
    if not target then return end

    -- Resolve the aim point (visible body point -> reprojected true pos + lead).
    local _, aimPos = PickPoint(target, Camera.CFrame.Position)
    if not aimPos then return end
    -- The smooth camlock (below) tracks the target continuously; the silent-aim hook still redirects
    -- the actual shot precisely, so hit reg doesn't depend on the camera being pixel-perfect.

    local combat = CombatService()
    local shootMod = ShootComponent()
    if not combat or not shootMod then return end

    local ok, weapon = pcall(combat.GetCurrentWeapon)
    if not ok or not weapon then return end

    local shootOk, shootable = pcall(shootMod.from, shootMod, weapon, "Shootable")
    if not shootOk or not shootable then return end

    -- Fire ONLY when the weapon itself says it's ready — this is the game's own rate/bolt-cycle gate,
    -- so we fire exactly at the weapon's cadence instead of dry-firing between shots (the "spam").
    local nowOk, canNow = pcall(shootable.CanShootNow, shootable)
    if not nowOk or not canNow then return end

    local ammoOk, canShoot = pcall(shootable.CanShoot, shootable)
    if ammoOk and canShoot == false then return end   -- out of ammo / can't attack (let it reload)

    Ragebot.LastShot = Workspace:GetServerTimeNow()
    local cam = Camera.CFrame
    pcall(shootable.Shoot, shootable, cam.Position, cam.LookVector, nil)
end

Connect(RunService.Heartbeat, function()
    SafeCall("ragebot.step", Ragebot.Step)
end)

--=====================================================================
-- Smooth camlock  (tracks the target's head with lerp + jitter so it doesn't read as a hard snap)
--=====================================================================
-- Head world position of a target character (real Head part, or ~1.5 studs above the root as R6/rig
-- fallback), reprojected onto the true server position.
local function TargetHeadPos(target)
    local root = target:FindFirstChild("HumanoidRootPart")
    local head = target:FindFirstChild("Head")
    local base = head and head.Position or (root and (root.Position + Vector3.new(0, 1.5, 0)))
    if not base then return nil end
    local plr = Players:GetPlayerFromCharacter(target)
    return Resolver.ReprojectPoint(plr, root, base)
end

local function StepCamlock()
    if not Config.CameraLock or not Ready or not Alive() or not IsGaming() then return end
    if Ragebot.WhiffThisGame then return end

    local target = Ragebot.CurrentTarget
    if not target then return end

    local aimPos = TargetHeadPos(target)
    if not aimPos then return end

    -- Small per-frame jitter so it's never pixel-locked.
    local j = Config.CamJitter
    if j > 0 then
        aimPos = aimPos + Vector3.new((math.random() * 2 - 1) * j, (math.random() * 2 - 1) * j, (math.random() * 2 - 1) * j)
    end

    local camPos = Camera.CFrame.Position
    if (aimPos - camPos).Magnitude < 1e-3 then return end

    -- Yaw locks straight onto the target 24/7 (horizontal is always on); pitch eases in smoothly so
    -- the vertical movement still looks human rather than a hard vertical snap.
    local goalPitch, goalYaw = CFrame.lookAt(camPos, aimPos):ToOrientation()
    local curPitch = select(1, Camera.CFrame:ToOrientation())
    local newPitch = curPitch + (goalPitch - curPitch) * math.clamp(Config.CamSmooth, 0.01, 1)

    Camera.CFrame = CFrame.new(camPos) * CFrame.fromOrientation(newPitch, goalYaw, 0)
end

Connect(RunService.RenderStepped, function()
    SafeCall("camlock", StepCamlock)
end)

--=====================================================================
-- Pathfinding (walk to current target with PathfindingService)
--=====================================================================
local Pather = { Path = nil, Index = 1, LastCompute = 0 }

-- Path visualization: client-side neon balls at each waypoint (blue = walk, orange = jump).
local PathViz = { Parts = {}, Folder = nil }

local function ClearPathViz()
    for i = 1, #PathViz.Parts do
        pcall(function() PathViz.Parts[i]:Destroy() end)
    end
    table.clear(PathViz.Parts)
end

local function RenderPath(waypoints)
    ClearPathViz()
    if not Config.VisualizePath or not waypoints then return end

    if not (PathViz.Folder and PathViz.Folder.Parent) then
        local f = Instance.new("Folder")
        f.Name = "FarmPathViz"
        f.Parent = Workspace
        PathViz.Folder = f
    end

    for i = 1, #waypoints do
        local wp = waypoints[i]
        local part = Instance.new("Part")
        part.Shape = Enum.PartType.Ball
        part.Size = Vector3.new(0.6, 0.6, 0.6)
        part.Position = wp.Position
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.Material = Enum.Material.Neon
        part.Color = (wp.Action == Enum.PathWaypointAction.Jump) and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(0, 200, 255)
        part.Transparency = 0.3
        part.Parent = PathViz.Folder
        PathViz.Parts[#PathViz.Parts + 1] = part
    end
end

local function WalkToward(targetPos)
    local char = LocalCharacter()
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = LocalRoot()
    if not hum or not root then return end

    -- Recompute the path periodically.
    if os.clock() - Pather.LastCompute > 0.6 then
        Pather.LastCompute = os.clock()
        local path = PathfindingService:CreatePath({
            AgentRadius = 3,
            AgentHeight = 5,
            AgentCanJump = true,
        })
        local ok = pcall(path.ComputeAsync, path, root.Position, targetPos)
        if ok and path.Status == Enum.PathStatus.Success then
            Pather.Path = path:GetWaypoints()
            Pather.Index = 1
            RenderPath(Pather.Path)
        else
            -- No navmesh path (common on custom Roblox maps). Fall back to a straight line toward the
            -- target so we still move AND still show a path — sampled points between us and them.
            if not Pather.LoggedNoPath then
                Pather.LoggedNoPath = true
                Log("pathfind:", ok and tostring(path.Status) or "ComputeAsync error", "- using straight-line fallback")
            end
            local waypoints = {}
            local segments = math.clamp(math.floor((targetPos - root.Position).Magnitude / 6), 1, 24)
            for i = 1, segments do
                waypoints[i] = { Position = root.Position:Lerp(targetPos, i / segments), Action = Enum.PathWaypointAction.Walk }
            end
            Pather.Path = waypoints
            Pather.Index = 1
            RenderPath(waypoints)
        end
    end

    if Pather.Path and Pather.Path[Pather.Index] then
        local wp = Pather.Path[Pather.Index]
        hum:MoveTo(wp.Position)
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end
        if ((root.Position - wp.Position) * Vector3.new(1, 0, 1)).Magnitude < 4 then
            Pather.Index += 1
        end
    else
        hum:MoveTo(targetPos)
    end
end

Connect(RunService.Heartbeat, function()
    if not Ready or not Config.Pathfind or not Alive() then return end
    if not IsGaming() then if #PathViz.Parts > 0 then ClearPathViz() end return end
    local target = Ragebot.CurrentTarget
    if target and EnemyAlive(target) then
        local root = target:FindFirstChild("HumanoidRootPart")
        if root then
            SafeCall("pathfind.walk", WalkToward, root.Position)
        end
    elseif #PathViz.Parts > 0 then
        ClearPathViz()
    end
end)

--=====================================================================
-- Forced walkspeed  (MoveTo cancels the game's Sprint state, so we force speed directly)
--=====================================================================
-- The game constantly resets WalkSpeed, so instead of polling we listen on its changed signal and
-- snap it back the instant the game touches it. Setting it only when it differs means the write we
-- make re-fires the signal once, sees it already matches, and stops — no infinite loop.
local function ApplyWalkSpeed(hum)
    if Config.WalkSpeed > 0 and hum.WalkSpeed ~= Config.WalkSpeed then
        hum.WalkSpeed = Config.WalkSpeed
    end
end

local function HookWalkSpeed(char)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if not hum then return end
    ApplyWalkSpeed(hum)
    Connect(hum:GetPropertyChangedSignal("WalkSpeed"), function()
        if Alive() then ApplyWalkSpeed(hum) end
    end)
end

if LocalPlayer.Character then task.spawn(HookWalkSpeed, LocalPlayer.Character) end
Connect(LocalPlayer.CharacterAdded, function(char)
    task.spawn(HookWalkSpeed, char)
end)

--=====================================================================
-- Stats readers (rank / kills / level / coins / net worth)
--=====================================================================
-- All of these come straight from the game's own client stores, the exact same ones the
-- Statistics / net-worth UI reads:
--   * StatusService.GetStatus(key)          -> coins, level, net worth, lifetime cases, mystic count
--     (safe to call any time: returns 0 before the store inits, never yields)
--   * StatsService.LocalStatsStore:GetStat(statKey, scope)  -> lifetime kills / headshots / deaths / W/L
--   * RankedService.GetRating(mode)          -> ranked rating + tier index (Duel = ranked 1v1)
--     RankingConfig.Tiers[tier].Display      -> "Gold II", "Master", ... (nil tier = Unranked)
-- These are literal keys, not module lookups: the game builds them via k2v, so every value equals
-- its own name (Stat.Kill == "Kill", Status.Level == "Level", ...). Using the strings directly means
-- we never dot-index a not-yet-replicated Constant module at load time (which hard-errors the script).
local StatKey       = { Kill="Kill", HeadshotKill="HeadshotKill", Death="Death", Win="Win", Lose="Lose" }
local StatusKey     = { Level="Level", Eco_Coin="Eco_Coin", NetWorth="NetWorth", WeaponValue="WeaponValue", Gachaed="Gachaed", MysticWeaponCount="MysticWeaponCount" }
local RankedModeKey = { Duel="Duel", Arcade="Arcade" }

-- Safe child resolve so a missing/late remote returns nil instead of throwing on dot-index.
local function ResolveRemote(name)
    local remote = ReplicatedStorage:FindFirstChild("Remote")
    return remote and remote:FindFirstChild(name)
end

local function StatusSvc()  return GetSvc("Status", ResolveRemote("StatusService"), { "GetStatus", "SetStatus", "AddStatus" }) end
local function StatsSvc()   return GetSvc("Stats",  ResolveRemote("StatsService"),  { "LocalStatsStore", "WaitInit", "OnInit" }) end
local function RankedSvc()  return GetSvc("Ranked", ResolveRemote("RankedService"), { "GetRating", "GetModeData", "ClaimReward" }) end
local RankingConfig

-- Group digits with commas: 56800 -> "56,800".
local function Comma(n)
    if type(n) ~= "number" then return tostring(n) end
    local s = string.format("%d", math.floor(n))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

local function GetStatus(key)
    local svc = StatusSvc()
    if not svc or not svc.GetStatus or not key then return 0 end
    local ok, v = pcall(svc.GetStatus, key)
    return (ok and type(v) == "number") and v or 0
end

local function GetStat(key, scope)
    local svc = StatsSvc()
    local store = svc and svc.LocalStatsStore
    if not store or not store.Data or not key then return 0 end
    local ok, v = pcall(store.GetStat, store, key, scope)  -- method call: (self, key, scope)
    return (ok and type(v) == "number") and v or 0
end

local function GetCoins()
    return GetStatus(StatusKey.Eco_Coin)
end

-- Net worth as the game tracks it; falls back to the inventory value status.
local function GetNetWorth()
    local nw = GetStatus(StatusKey.NetWorth)
    if nw > 0 then return nw end
    return GetStatus(StatusKey.WeaponValue)
end

-- "Gold II (1234)" style rank string for ranked 1v1 (Duel). nil if we can't read it yet.
local function GetRankString()
    local svc = RankedSvc()
    if not svc or not svc.GetRating then return nil end

    local ok, rating, tier = pcall(svc.GetRating, RankedModeKey.Duel)
    if not ok then return nil end

    RankingConfig = RankingConfig or ResolveModule(SafeChild(ReplicatedStorage, "Config", "RankingConfig"), { "Tiers", "GetSeasonConfig" })
    local info = RankingConfig and RankingConfig.Tiers and tier and RankingConfig.Tiers[tier]
    local display = (info and info.Display) or "Unranked"

    return string.format("%s (%s)", display, Comma(rating or 0))
end

--=====================================================================
-- Auto Sell  (SAFE: only Common/UnCommon/Rare/Epic, always via CanSell)
--=====================================================================
local function DoAutoSell()
    if not Config.AutoSell then return end
    local weapon = WeaponService()
    local wdh = WeaponDataHelper()
    if not weapon or not wdh then return end

    local content = weapon.GetContent and weapon.GetContent()
    if type(content) ~= "table" then return end

    local toSell = {}
    for uid, data in pairs(content) do
        local cfgOk, cfg = pcall(wdh.GetConfig, data)
        -- Effective rarity = SecondaryRarity (the SKIN's rarity) or Rarity (base gun) — exactly how the
        -- game's own GetRaritySortOrder resolves it. Reading only .Rarity meant only the SSG base gun
        -- (Rarity=Common) matched; every skin's rarity is on .SecondaryRarity.
        local rarity = cfgOk and cfg and (cfg.SecondaryRarity or cfg.Rarity)
        if rarity and SellRarities[rarity] then
            local sellOk, can = pcall(weapon.CanSell, data)
            if sellOk and can then
                toSell[#toSell + 1] = uid
            end
        end
    end

    if #toSell == 0 then return end

    -- Sell in modest batches.
    for i = 1, #toSell, 40 do
        if not Alive() then return end
        local batch = {}
        for j = i, math.min(i + 39, #toSell) do
            batch[#batch + 1] = toSell[j]
        end
        pcall(weapon.Sell, batch)
        Session.ItemsSold += #batch
        task.wait(0.5)
    end
    Log("sold", #toSell, "junk skins")
end

